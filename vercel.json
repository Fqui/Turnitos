{
    "rewrites": [
        {
            "source": "/:slug*",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Discordbot|LinkedInBot|Slackbot|SkypeUriPreview).*"
                }
            ],
            "destination": "/api/og?slug=:slug*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}